#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.14"
# dependencies = [
#   "cloakbrowser",
#   "cloakbrowser[geoip]",
#   "playwright",
#   "structlog",
# ]
# ///
import argparse
import base64
import gzip
import json
from urllib.parse import urldefrag

from cloakbrowser import launch, ProxySettings
from playwright.sync_api import Browser, Page, Error


def collect_links(page: Page) -> list[str]:
    hrefs = page.locator('a[href]').evaluate_all("""
                                                 els => els.map(el => el.href.trim()).filter(s => s.startsWith('http'))
                                                 """)
    return sorted({urldefrag(href).url for href in hrefs})


def collect_all_meta(page: Page) -> dict[str, str | list[str]]:
    pairs = page.locator('meta[content]').evaluate_all("""
                                                       els => els
                                                           .map(el => [
                                                               (el.getAttribute('name') || el.getAttribute('property') || el.getAttribute('http-equiv') || el.getAttribute('itemprop') || '').trim(),
                                                               (el.getAttribute('content') || '').trim(),
                                                           ])
                                                           .filter(([key, val]) => key !== '' && val !== '')
                                                       """)
    meta: dict[str, list[str]] = {}
    for key, val in pairs:
        vals = meta.setdefault(key, [])
        if val not in vals:
            vals.append(val)
    return {key: vals[0] if len(vals) == 1 else vals for key, vals in meta.items()}

def main(
        url: str,
        headless: bool,
        proxy: ProxySettings | None,
) -> None:

    if proxy is not None:
        browser: Browser = launch(proxy=proxy, headless=headless, humanize=False, human_preset="careful", geoip=True)
    else:
        browser: Browser = launch(headless=headless, humanize=True, human_preset="careful", geoip=True)

    page = browser.new_page()
    try:
        page.goto(url=url)
        page.wait_for_load_state('domcontentloaded', timeout=5_000)
        print(json.dumps({
            'title': page.title(),
            'meta': collect_all_meta(page),
            'links': collect_links(page),
            'screenshot': base64.b64encode(gzip.compress(page.screenshot(full_page=True))).decode('utf-8'),
        }, indent=2))
    except Error as e:
        print(json.dumps({'error': e}))
    finally:
        page.close()
        browser.close()


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Run the pages 🤖")
    _ = parser.add_argument('-u', '--url', help='Page URL')
    _ = parser.add_argument('-m', '--mode', help='Headless or Headed browser', type=bool, default=True)
    _ = parser.add_argument('-ps', '--proxy_scheme', type=str, default='http')
    _ = parser.add_argument('-ph', '--proxy_host', type=str, default='')
    _ = parser.add_argument('-pu', '--proxy_user', type=str, default='')
    _ = parser.add_argument('-px', '--proxy_pass', type=str, default='')
    _ = parser.add_argument('-pp', '--proxy_port', type=str, default='')
    args = parser.parse_args()

    proxy_val = None
    if args.proxy_host != '':
        proxy_val = ProxySettings(
            username=args.proxy_user,
            password=args.proxy_pass,
            server=f"{args.proxy_scheme}://{args.proxy_host}:{args.proxy_port}",
        )

    main(
        url=args.url,
        headless=args.mode,
        proxy=proxy_val,
    )
